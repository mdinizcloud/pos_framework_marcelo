---
import '../styles/theme.css';
import { site, promptSite } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  // Qual vitrine esta página pertence — decide o brand principal do header/footer
  // e qual selo do "outro" registro aparece do lado, linkando pra outra seção
  // dentro do mesmo servidor/porta (ver plano de unificação prompt+skill registry).
  section?: 'skills' | 'prompts';
}
const { title, description, section = 'skills' } = Astro.props;

const current = section === 'prompts' ? promptSite : site;
const other = section === 'prompts' ? { ...site, href: '/' } : { ...promptSite, href: '/prompts' };

const resolvedDescription = description ?? current.description;
const fullTitle = title ? `${title} · ${current.name}` : `${current.name} — ${current.tagline}`;
---

<!doctype html>
<html lang="pt-BR" class="dark" data-section={section}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={resolvedDescription} />
    <title>{fullTitle}</title>
    {/* Evita flash de tema: aplica preferência salva antes da pintura. */}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white text-zinc-900 antialiased dark:bg-surface-0 dark:text-zinc-100">
    <header class="sticky top-0 z-20 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-surface-border dark:bg-surface-0/90">
      <div class="mx-auto flex max-w-[1400px] items-center justify-between px-4 py-3 sm:px-6">
        <div class="flex items-center gap-3">
          <a href={section === 'prompts' ? '/prompts' : '/'} class="flex items-center gap-2.5 text-[15px] font-bold tracking-tight">
            <img src={current.logo} alt={current.name} class="h-7 w-7 rounded-md" />
            {current.name}
          </a>
          <a
            href={other.href}
            class="flex items-center gap-1.5 rounded-full border border-zinc-200 py-0.5 pl-0.5 pr-2.5 text-xs font-semibold text-zinc-500 transition hover:border-brand-300 hover:text-brand-600 dark:border-surface-border dark:text-zinc-400 dark:hover:border-brand-500/50 dark:hover:text-brand-300"
            title={`Abrir ${other.name}`}
          >
            <img src={other.logo} alt="" class="h-5 w-5 rounded" />
            {other.name}
          </a>
        </div>
        <button
          id="theme-toggle"
          type="button"
          aria-label="Alternar tema"
          class="rounded-md border border-zinc-200 px-2 py-1 text-sm text-zinc-600 hover:bg-zinc-100 dark:border-surface-border dark:text-zinc-300 dark:hover:bg-surface-1"
        >
          <span class="hidden dark:inline">☀︎</span>
          <span class="inline dark:hidden">☾</span>
        </button>
      </div>
    </header>

    <main class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6">
      <slot />
    </main>

    <footer class="mt-16 border-t border-zinc-200 py-8 text-sm text-zinc-500 dark:border-surface-border dark:text-zinc-500">
      <div class="mx-auto flex max-w-[1400px] flex-wrap items-center gap-x-2 gap-y-1.5 px-4 sm:px-6">
        <span>{current.name} · por {current.author.name}</span>
        <span aria-hidden="true">·</span>
        {section === 'prompts' ? (
          <span>
            Adicionar prompt novo: <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-xs dark:bg-surface-1">/catalogar-prompt</code>
          </span>
        ) : (
          <>
            <span>
              Instalar todas as skills: <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-xs dark:bg-surface-1">{site.repo.installAll}</code>
            </span>
            <span aria-hidden="true">·</span>
            <span>
              Adicionar skill nova: <code class="rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-xs dark:bg-surface-1">/catalogar-skill</code>
            </span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <a
          href={`https://github.com/${current.author.github}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-brand-600 dark:hover:text-brand-300"
        >
          <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          {current.author.github}
        </a>
      </div>
    </footer>

    <img
      src="/penguin.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none fixed bottom-0 right-4 z-10 hidden h-[176px] w-auto select-none sm:h-[252px] sm:right-6 min-[1600px]:block"
    />

    <img
      src="/decor-layers.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none fixed left-0 top-[94px] z-0 hidden h-[220px] w-auto select-none opacity-[0.65] sm:h-[280px] min-[1850px]:block"
    />

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });
    </script>
  </body>
</html>
