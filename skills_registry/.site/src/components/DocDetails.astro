---
interface Props {
  id: string;
  filename: string;
  open?: boolean;
}
const { id, filename, open = false } = Astro.props;
---
<details id={id} class="group/doc mt-4 rounded-lg border border-zinc-200 dark:border-surface-border" open={open}>
  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-4 py-3 text-sm font-medium text-zinc-700 hover:bg-zinc-50 dark:text-zinc-300 dark:hover:bg-surface-1">
    <svg class="h-3 w-3 shrink-0 text-zinc-400 transition-transform group-open/doc:rotate-90" viewBox="0 0 8 8" fill="currentColor" aria-hidden="true"><path d="M1 0l6 4-6 4V0z" /></svg>
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 1.5h5l3 3v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1z"/><path d="M9 1.5V5h3.5"/></svg>
    {filename}
  </summary>
  <div class="border-t border-zinc-200 px-4 py-4 dark:border-surface-border">
    <slot />
  </div>
</details>
