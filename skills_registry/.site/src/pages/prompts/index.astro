---
// Porta de prompt_registry/.site/src/pages/index.astro — home da seção /prompts,
// lendo ao vivo o repo irmão prompt_registry (ver content.config.ts).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PromptCard from '../../components/prompts/PromptCard.astro';
import PromptCategoryTree from '../../components/prompts/PromptCategoryTree.astro';
import { buildPromptTree } from '../../lib/promptTree';
import { promptSite } from '../../site.config';

const prompts = (await getCollection('prompts')).sort((a, b) => a.data.name.localeCompare(b.data.name));

const tree = buildPromptTree(prompts);
const domains = new Set(prompts.map((p) => p.data.domain)).size;
---
<Base title={promptSite.name} description={promptSite.description} section="prompts">
  <section class="mb-6">
    <div class="flex flex-wrap items-center gap-3">
      <img src={promptSite.logo} alt="" class="h-10 w-10 shrink-0 rounded-lg" />
      <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{promptSite.name}</h1>

      <div class="relative ml-auto w-full sm:w-[32rem]">
        <svg viewBox="0 0 16 16" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-zinc-400" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="5.5"/><path d="M11.5 11.5L14.5 14.5" stroke-linecap="round"/></svg>
        <input
          id="search-input"
          type="text"
          placeholder="Buscar prompts..."
          class="w-full rounded-lg border border-zinc-200 bg-white py-2 pl-9 pr-3 text-sm text-zinc-800 placeholder:text-zinc-400 focus:border-brand-400 focus:outline-none focus:ring-1 focus:ring-brand-400 dark:border-surface-border dark:bg-surface-1 dark:text-zinc-100 dark:placeholder:text-zinc-500"
        />
      </div>
    </div>
    <p class="mt-1 text-zinc-600 dark:text-zinc-400">{promptSite.tagline}</p>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-500">
      {domains} domínios · {prompts.length} prompts
    </p>
  </section>

  <div class="flex flex-col gap-8 md:flex-row">
    <aside class="md:w-64 md:shrink-0">
      <div class="md:sticky md:top-16">
        <div class="mb-2 flex items-center justify-between px-2">
          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-400 dark:text-zinc-500">Domínios</p>
          <div class="flex items-center gap-0.5">
            <button type="button" id="tree-collapse-all" title="Recolher tudo" aria-label="Recolher tudo" class="rounded p-1 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-surface-2 dark:hover:text-zinc-200">
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l4-4 4 4M4 14l4-4 4 4"/></svg>
            </button>
            <button type="button" id="tree-expand-all" title="Expandir tudo" aria-label="Expandir tudo" class="rounded p-1 text-zinc-400 transition hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-surface-2 dark:hover:text-zinc-200">
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4l4 4 4-4M4 12l4 4 4-4"/></svg>
            </button>
          </div>
        </div>
        <div id="tree-root" class="max-h-[calc(100vh-6rem)] overflow-y-auto overscroll-contain pr-1">
          <PromptCategoryTree nodes={tree} />
        </div>
      </div>
    </aside>
    <section id="prompt-list" class="grid min-w-0 flex-1 grid-cols-1 gap-4 self-start sm:grid-cols-2 xl:grid-cols-3">
      {prompts.map((p) => (
        <PromptCard id={p.id} name={p.data.name} category={p.data.category} blurb={p.data.descricao} tags={p.data.tags} hasReadme={p.data.hasReadme} />
      ))}
    </section>
  </div>
</Base>

<script>
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('#prompt-list > article'));

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    for (const card of cards) {
      const haystack = card.textContent?.toLowerCase() ?? '';
      card.classList.toggle('hidden', q.length > 0 && !haystack.includes(q));
    }
  });

  const treeRoot = document.getElementById('tree-root');
  document.getElementById('tree-collapse-all')?.addEventListener('click', () => {
    treeRoot?.querySelectorAll('details').forEach((d) => { (d as HTMLDetailsElement).open = false; });
  });
  document.getElementById('tree-expand-all')?.addEventListener('click', () => {
    treeRoot?.querySelectorAll('details').forEach((d) => { (d as HTMLDetailsElement).open = true; });
  });
</script>
